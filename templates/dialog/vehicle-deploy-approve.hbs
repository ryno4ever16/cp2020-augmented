{{!-- GM approval step of the vehicle deploy flow (players may request; the active GM's client
      creates the actor on approve — no player actor-creation permission involved). --}}
<div class="cp-deploy-approve-body">
    <p>{{CPLocal "VehicleDeployApproveBody" requester=requesterName vehicle=vehicleName}}</p>
    <p class="cp-deploy-approve-name">{{CPLocal "VehicleDeployNameLabel"}}: <strong>{{proposedName}}</strong></p>
</div>
