{{!--
  Cyberware install confirm dialog (DialogV2 content), rendered from _confirmInstall(). Cost rows
  (the part-cost line only when buying, showPart) + the option checkboxes — name="paySurgery",
  name="rollHumanity" and name="applyDamage" are read by the OK-button callback, so keep them verbatim.
  `partUnpriced` = the part has no catalog price yet (the GM sets one on the request), so there is no
  total to show. `paySurgery` is offered only when there is a fee to pay. Values are auto-escaped by
  Handlebars (no esc() needed). i18n via CPLocal.
  The root is a <div>, not a <form>: DialogV2 wraps its content in a form of its own, and a browser drops
  a form nested inside another — which took this root's classes, and the label styling keyed on them, with it.
--}}
<div class="cyberpunk cp-cyber-install">
  {{#if installedAlready}}<div class="cp-cyber-install-note">{{CPLocal "CyberInstallRechargeNote"}}</div>{{/if}}
  {{#if showPart}}<div>{{CPLocal "CyberPartCost"}}: {{#if partUnpriced}}<b>{{CPLocal "ShopPriceUnset"}}</b>{{else}}<b>{{partPrice}}</b>eb{{/if}}</div>{{/if}}
  <div>{{CPLocal "CyberSurgeryCost"}} ({{surgeryLabel}}): <b>{{surgeryCost}}</b>eb</div>
  {{#unless partUnpriced}}<div>{{CPLocal "CyberTotalCost"}}: <b>{{total}}</b>eb</div>{{/unless}}
  <hr/>
  {{#if surgeryCost}}
  <label>
    <input type="checkbox" name="paySurgery" checked/> {{CPLocal "CyberPaySurgery"}} ({{surgeryCost}}eb)
  </label>
  {{/if}}
  <label>
    <input type="checkbox" name="rollHumanity" {{#unless rolledAlready}}checked{{/unless}}/> {{CPLocal "CyberRollHumanity"}} ({{hc}}){{#if rolledAlready}} — {{CPLocal "CyberHumanityRolledAlready" n=humanityLoss}}{{/if}}
  </label>
  <label>
    <input type="checkbox" name="applyDamage" checked/> {{CPLocal "CyberApplyDamage"}} ({{surgeryDamage}})
  </label>
</div>
