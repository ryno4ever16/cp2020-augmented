{{!--
  radiation-panel.hbs — the Deep Space radiation hub (R3b). Included from combat.hbs, guarded on
  `radiation.show` (GM or the OWNING player, and the actor actually carries radiation — a marker, current
  exposure, or lifetime history). Shows the running exposure, lifetime history,
  the actor's RSP, and any active radiation stat loss, plus the five controls (apply dose to this actor,
  roll the long-term reference, clear the current exposure, cure the stat loss, reset). The .cp-rad-*
  buttons are handled by _cpActivateRadiationControls in module/actor/actor-sheet.js. Readout values are
  built in _prepareContext. i18n via CPLocal; no HTML/CSS in JS.

  ⭐ READ-ONLY FOR A NON-GM VIEWER (user ruling, 2026-08-29): `radiation.canEdit` is GM-only, and every
  control carries `disabled` without it — the owner reads the dose, the GM is the only one who moves it.
--}}
<section class="radiation-section cp-radiation-panel">
  <header>
    <h2 title="{{CPLocal 'RadPanelHint'}}">☢ {{CPLocal "RadPanelHeader"}}</h2>
  </header>

  <div class="field">
    <label title="{{CPLocal 'RadPanelExposureHint'}}">{{CPLocal "RadPanelExposure"}}</label>
    <span class="flex-pad"></span>
    <span class="cp-rad-readout">{{radiation.exposure}}</span>
  </div>
  <div class="field">
    <label title="{{CPLocal 'RadPanelHistoryHint'}}">{{CPLocal "RadPanelHistory"}}</label>
    <span class="flex-pad"></span>
    <span class="cp-rad-readout">{{radiation.history}}</span>
  </div>
  <div class="field">
    <label title="{{CPLocal 'RadPanelRspHint'}}">{{CPLocal "RadPanelRsp"}}</label>
    <span class="flex-pad"></span>
    <span class="cp-rad-readout">{{radiation.rsp}}</span>
  </div>
  {{#if radiation.statLoss}}
  <div class="field cp-rad-statloss-row">
    <label>{{CPLocal "RadPanelStatLoss"}}</label>
    <span class="flex-pad"></span>
    <span class="cp-rad-readout">{{radiation.statLoss}}</span>
  </div>
  {{/if}}

  <div class="radiation-actions">
    <button type="button" class="cp-rad-apply" title="{{CPLocal 'RadBtnApplyHint'}}" {{#unless radiation.canEdit}}disabled{{/unless}}>☢ {{CPLocal "RadBtnApply"}}</button>
    <button type="button" class="cp-rad-longterm" title="{{CPLocal 'RadBtnLongTermHint'}}" {{#unless radiation.canEdit}}disabled{{/unless}}>🧬 {{CPLocal "RadBtnLongTerm"}}</button>
    <button type="button" class="cp-rad-clear" title="{{CPLocal 'RadBtnClearHint'}}" {{#unless radiation.canEdit}}disabled{{/unless}}>{{CPLocal "RadBtnClear"}}</button>
    <button type="button" class="cp-rad-cure" title="{{CPLocal 'RadBtnCureHint'}}" {{#unless radiation.canEdit}}disabled{{/unless}}>{{CPLocal "RadBtnCure"}}</button>
    <button type="button" class="cp-rad-reset" title="{{CPLocal 'RadBtnResetHint'}}" {{#unless radiation.canEdit}}disabled{{/unless}}>🗑 {{CPLocal "RadBtnReset"}}</button>
  </div>
</section>
