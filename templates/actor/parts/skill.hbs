{{!-- Really I want there to be the same kind of deleting for items and skills, but there's not enough real estate to add the Xs, and too much interactivity to move things around. May need some UI thinking --}}
<div class="field skill" data-item-id="{{skill.id}}">
    <label class="skill-roll action" data-skill-id="{{skill.id}}">{{#if skill.displayName}}{{skill.displayName}}{{else}}{{skill.name}}{{/if}}</label>
    {{#with skill.system}}
        <label class="chip-toggle" data-skill-id="{{../skill.id}}">
            <div class="skill-stat-display">
                {{~#if isRoleSkill~}}
                    {{CPLocal (properCase stat)}} [{{CPLocal "Role"}}]
                {{~else}}
                    {{CPLocal (properCase stat)}}
                {{~/if~}}
            </div>
            <div class="chip-icon {{#unless isChipped}}inactive{{/unless}}"></div>
            {{!-- The chip tick is what makes the row roll at its CHIP level instead of its trained level
                  (realSkillValue), which is also why the level box then edits chipLevel — so the tooltip
                  says that outright. A chip-driven row keeps the narrower "controlled by chip" title. --}}
            <input class="chip-toggle-checkbox" type="checkbox" data-skill-id="{{../skill.id}}" {{checked isChipped}} title="{{#if autoChipped}}{{CPLocal 'ControlledByChip'}}{{else}}{{CPLocal 'SkillChipToggleHint'}}{{/if}}" />
        </label>

    <span class="item-controls">
        <span class="skill-mod-toggle">
        <input type="checkbox" class="skill-ask-mod" data-skill-id="{{../skill.id}}" {{checked askMods}}>
        </span>
        <i class="fas fa-edit item-edit"   data-item-id="{{../skill.id}}"></i>
        <i class="fas fa-trash item-delete" data-item-id="{{../skill.id}}"></i>
    </span>

    <input type="number" data-skill-id="{{../skill.id}}" class="skill-level smallnumber nogrow"
        value="{{#if isChipped}}{{chipLevel}}{{else}}{{level}}{{/if}}"
        {{#if autoChipped}}readonly title="{{CPLocal 'ControlledByChip'}}"{{else}}{{#if @root.ip.locked}}readonly title="{{CPLocal 'IpSkillLockToggle'}}"{{/if}}{{/if}}
    />
    {{/with}}

    {{!-- IP tracker: banked IP / cost, the pool's contribution when the bank alone doesn't cover the
          raise, the GM-only pending pip, and the self-service level-up control.
          ⚠ {{#with}} RE-POINTS the context to `ipd`, so `skill` is only reachable as `../skill` in
          here — a bare {{skill.id}} renders EMPTY and leaves the control unable to name its row. --}}
    {{#if @root.ip.enabled}}
    {{#with (lookup @root.ipBySkill skill.id) as |ipd|}}
    <span class="cp2020ae-ip-cluster" title="{{CPLocal 'IpBanked'}} {{ipd.banked}} / cost {{ipd.cost}}">
        {{#if @root.ip.showPending}}{{#if ipd.pending}}<span class="cp2020ae-ip-pending-pip" title="{{CPLocal 'IpPendingPip'}}">+{{ipd.pending}}</span>{{/if}}{{/if}}
        <span class="cp2020ae-ip-banked">{{ipd.banked}}/{{ipd.cost}}</span>
        {{#if ipd.fromPool}}<span class="cp2020ae-ip-from-pool" title="{{CPLocal 'IpFromPoolHint' pool=ipd.fromPool}}">{{CPLocal 'IpFromPool' pool=ipd.fromPool}}</span>{{/if}}
        {{#if ipd.canLevel}}<i class="fas fa-arrow-up cp2020ae-ip-level-up action{{#if ipd.fromPool}} cp2020ae-ip-level-up--pooled{{/if}}" data-skill-id="{{../skill.id}}" title="{{#if ipd.fromPool}}{{CPLocal 'IpLevelUpPooled' cost=ipd.cost pool=ipd.fromPool}}{{else}}{{CPLocal 'IpLevelUpBanked' cost=ipd.cost}}{{/if}}"></i>{{/if}}
    </span>
    {{/with}}
    {{/if}}
</div>