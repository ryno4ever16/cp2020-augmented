{{!-- Stuff that affects a single given attack's effects at the other end --}}
<div class="field-list">
    {{> (template "fields/string") label="Damage" edit="system.damage"}}
    {{> (template "fields/number") label="Accuracy" edit="system.accuracy"}}
    {{> (template "fields/number") label="Range" edit="system.range"}}

    {{!-- allowBlank (2026-09-19): a stored value outside the enum (blank, or the book's own "ST"/"VR"
          abbreviations) used to render as the FIRST option — "Very Reliable" — and would then be SAVED
          as VeryReliable on the next submit. Same treatment as Concealability / Availability below. --}}
    {{> (template "fields/select") label="Reliability" edit="system.reliability" choices=reliabilities allowBlank=true}}
</div>

{{!-- Ammo-related fields: only for ranged weapons --}}
{{#unless (equals system.weaponType 'Melee')}}
<div class="field-list">
    {{> (template "fields/number") label="ShotsLeft" edit="system.shotsLeft"}}
    {{> (template "fields/number") label="Shots" edit="system.shots"}}
    {{> (template "fields/number") label="RoF" edit="system.rof"}}
    {{> (template "fields/select") label="Ammo" edit="system.ammoItemId" choices=ammoChoices allowBlank=true}}
    {{!-- Fire-mode capability (our net-new). Full auto also grants Suppressive; burst is separate (e.g. M16A4). --}}
    {{> (template "fields/boolean") label="FullAutoCapable" edit="system.fullAutoCapable"}}
    {{> (template "fields/boolean") label="BurstCapable" edit="system.burstCapable"}}
</div>
{{/unless}}

{{!-- What kind of thing is this weapon, how it's used --}}
<div class="field-list">
    {{!-- When changing weapon type, the weapon's attack type will not update correspondingly until the sheet is closed --}}
{{!-- allowBlank (2026-09-19 select sweep): a stored value outside the enum used to render as the FIRST
      option and be SAVED as that on the next submit — the mechanism that rewrote 1.0.x-era weapons'
      reliability / attack type / concealability across users' worlds. Blank is honest; first-option is a lie. --}}
    {{> (template "fields/select") label="WeaponType" edit="system.weaponType" choices=weaponTypes allowBlank=true}}
    {{> (template "fields/select") label="AttackType" edit="system.attackType" choices=attackTypes allowBlank=true}}
    {{!-- Custom, as all the translate keys start with Skill, but they don't in the character --}}
    {{!-- This might not need to be custom anymore, as regular selects can deal with choices that supply their own translateKeys --}}
    <div class="field">
        <label for="system.attackSkill">{{CPLocal "AttackSkill"}}</label>
        <div class="flex-pad"></div>
        {{#if (equals system.weaponType 'Exotic')}}
            {{!-- This will be populated by actor skills if it's held by an actor, but an input is at least editable --}}
            <datalist id="possibleSkills">
                {{#each attackSkills as |skill|}}
                <option value="{{skill.value}}">{{skill.label}}</option>
                {{/each}}
            </datalist>
            <input type="text" list="possibleSkills" placeholder="Choose Skill" name="system.attackSkill" value="{{system.attackSkill}}"/>
        {{else}}
            <select name="system.attackSkill">
                {{#each attackSkills as |skill|}}
                <option value="{{skill.value}}" {{#if (equals ../system.attackSkill skill.value)}}selected{{/if}}{{#if (equals ../system.attackSkill skill.label)}}selected{{/if}}>{{skill.label}}</option>
                {{/each}}
            </select>
        {{/if}}
    </div>
    {{!-- allowBlank so a weapon whose stored value is blank (or otherwise outside the enum) renders
          as blank instead of silently displaying — and, on the next save, silently STORING — the
          first option. Same treatment as AttackType above. --}}
    {{> (template "fields/select") label="Concealability" edit="system.concealability" choices=concealabilities allowBlank=true}}
</div>

{{!-- Market stuff --}}
<div class="field-list">
    {{!-- allowBlank: same reason as Concealability — the corrections layer normalizes the packs'
          placeholder availability to a blank, which needs a blank option to round-trip a save. --}}
    {{> (template "fields/select") label="Availability" edit="system.availability" choices=availabilities allowBlank=true}}

    {{#if isMelee}}
        {{> (template "fields/boolean") label="AP" edit="system.ap"}}
        {{!-- Melee armor-interaction categories (our net-new). Edged: ½ SP vs soft armor (CP2020 p.111).
              Mono: mono-edge — ⅓ SP vs soft / ⅔ SP vs hard, and breaks on a fumble (p.112). Broken is
              set by the mono break-on-fumble rule; the checkbox lets a GM clear it (repair). --}}
        {{> (template "fields/boolean") label="Edged" edit="system.edged"}}
        {{> (template "fields/boolean") label="Mono" edit="system.mono"}}
        {{> (template "fields/boolean") label="Broken" edit="system.broken"}}
    {{else}}
        {{> (template "fields/string") label="AmmoType" edit="system.ammoType"}}
    {{/if}}
</div>

{{!-- ===== Over-time effects on the weapon itself (user-ruled 2026-09-19; reviewed 2026-09-19 night) =====
      At most ONE row per type: acid eats the location's armour by the acid roll each round and sears the
      rest through when the armour is gone (Core p.107-108); fire burns hit points. The sheet builds
      `overTimeRows` (item-sheet.js _prepareContext): each row knows whether it is fire (the flat opt-out is
      fire's alone — acid never halves, so the box is not drawn on an acid row) and which type the OTHER row
      already holds (that option is disabled). Add appends the missing type and is gone once both exist.
      Rows are name-bound as system.overTime.N.* so the sheet's ordinary submit writes the array; add /
      remove / seed-on-type are explicit writes (_cpActivateWeaponOverTimeControls). The explanation lives
      on each row's type select as a tooltip chosen by the row's type — no paragraph under the header. --}}
<div class="field-list cp-weapon-overtime">
    <div class="field span-two-cells">
        <label class="larger">{{CPLocal "WeaponOverTimeSection"}}</label>
        <span class="flex-pad"></span>
        {{#if editable}}{{#if overTimeCanAdd}}<button type="button" class="cp-ot-add" data-tooltip="{{CPLocal 'WeaponOverTimeAddTip'}}">{{CPLocal "WeaponOverTimeAdd"}}</button>{{/if}}{{/if}}
    </div>
    {{#each overTimeRows as |row|}}
    <div class="field span-two-cells cp-ot-row" data-index="{{row.i}}">
        <select name="system.overTime.{{row.i}}.type" class="cp-ot-type" data-tooltip="{{#if row.isFire}}{{CPLocal 'WeaponOverTimeFireTip'}}{{else}}{{CPLocal 'WeaponOverTimeAcidTip'}}{{/if}}">
            <option value="acid" {{#unless row.isFire}}selected{{/unless}} {{#if row.acidTaken}}disabled{{/if}}>{{CPLocal "OverTimeAcid"}}</option>
            <option value="fire" {{#if row.isFire}}selected{{/if}} {{#if row.fireTaken}}disabled{{/if}}>{{CPLocal "OverTimeFire"}}</option>
        </select>
        <label class="cp-ot-lbl">{{CPLocal "WeaponOverTimeTurns"}}</label>
        <input type="number" name="system.overTime.{{row.i}}.turns" value="{{row.turns}}" min="0" step="1" class="cp-ot-turns" data-tooltip="{{CPLocal 'WeaponOverTimeTurnsTip'}}"/>
        <label class="cp-ot-lbl">{{CPLocal "WeaponOverTimeFormula"}}</label>
        <input type="text" name="system.overTime.{{row.i}}.formula" value="{{row.formula}}" placeholder="{{CPLocal 'WeaponOverTimeFormulaBlank'}}" class="cp-ot-formula cp-formula-field" data-tooltip="{{CPLocal 'WeaponOverTimeFormulaTip'}}"/>
        {{#if row.isFire}}<label class="cp-ot-lbl cp-ot-flat" data-tooltip="{{CPLocal 'WeaponOverTimeFlatTip'}}"><input type="checkbox" name="system.overTime.{{row.i}}.flat" {{#if row.flat}}checked{{/if}}/>{{CPLocal "WeaponOverTimeFlat"}}</label>{{/if}}
        {{#if ../editable}}<button type="button" class="cp-ot-remove" data-index="{{row.i}}" data-tooltip="{{CPLocal 'WeaponOverTimeRemoveTip'}}">✕</button>{{/if}}
    </div>
    {{/each}}
</div>
