<div class="field-list">
    {{>(template "fields/number") label="Level" edit="system.level"}}
    {{>(template "fields/number") label="LevelChipped" edit="system.chipLevel"}}
    {{>(template "fields/boolean") label="Chipped" edit="system.isChipped"}}
</div>

{{!-- The vanilla sheet's Improvement Points field, restored (1.2.3, user request) — but wired to
      the MODULE's bank rather than the base schema's `system.ip`: the module banks per-skill IP in
      flags.cp2020-augmented.ip, and only the flag funds a raise. The vanilla field's box is the
      gesture people know (click the skill, type IP); pointing it at system.ip again would only
      invite numbers nothing spends, so that field stays unsurfaced. Owner-editable, exactly like
      vanilla — no GM gate, no lock check (user ruling 2026-09-01: mirror vanilla). --}}
<div class="field-list">
    {{>(template "fields/number") label="ImprovementPoints" edit="flags.cp2020-augmented.ip"}}
</div>

<div class="field-list">
    {{>(template "fields/number") label="DifficultyMod" edit="system.diffMod"}}
</div>
{{!-- Built-in martial-art styles ship this field unset (the schema default 1), so while it reads 1
      the IP cost helper prices the raise off the module's style table instead. Say so, rather than
      leaving the box reading a number the cost does not use. Typing a value here overrides it. --}}
{{#if ipMultiplierFromTable}}
<p class="cp-field-note">{{CPLocal "SkillIpMultiplierFromTable" mult=ipMultiplierFromTable}}</p>
{{/if}}
<div class="field-list">
    {{>(template "fields/select") label="Stat" edit="system.stat" choices=stats noTranslateOptions=true}}
    {{>(template "fields/boolean") label="IsRoleSkill" edit="system.isRoleSkill"}}
</div>

<div class="field-list">
    {{>(template "fields/boolean") label="IsMartialArt" edit="flags.cp2020-augmented.isMartialArt"}}
</div>

{{#if (deepLookup . "flags.cp2020-augmented.isMartialArt")}}
<h3>{{CPLocal "MartialArtBonuses"}}</h3>
<p class="notes" style="font-size:0.85em; opacity:0.75; margin:2px 0 6px;">{{CPLocal "MartialArtBonusesHint"}}</p>
<div class="field-list">
    {{#each martialBonusActions as |action|}}
        {{!-- pass @root as context so the number field reads system.martialBonuses.* from the sheet data, not the loop's action string --}}
        {{>(template "fields/number") @root label=action edit=(concat "flags.cp2020-augmented.martialBonuses." action)}}
    {{/each}}
</div>
{{/if}}