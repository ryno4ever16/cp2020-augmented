{{> "modules/cp2020-augmented/templates/actor/parts/armor-display.hbs" hitLocations=system.coverage edit=true hitLocsName="coverage"}}
<div class="field-list one-col">
    {{> (template "fields/number") label="Encumbrance" edit="system.encumbrance"}}
    {{!-- Hard/soft classification (drives the edged/mono SP multipliers). Blank = "Auto" (the
          name/encumbrance heuristic in getArmorHardness); "soft"/"hard" force it. --}}
    {{> (template "fields/select") label="ArmorType" edit="system.armorType" choices=armorTypeChoices}}
</div>
{{!-- Armor degradation writes the reduced stopping power straight into the coverage boxes above, so
      a worn garment's original rating survives nowhere on the actor. This puts it back from the
      item's own pack entry. GM-only, and absent entirely when no pack entry resolves. --}}
{{#if canRestoreArmor}}
<div class="field">
    <label>{{CPLocal "ArmorRestoreHint"}}</label>
    <span class="flex-pad"></span>
    <button type="button" class="cp-armor-restore nogrow">{{CPLocal "ArmorRestore"}}</button>
</div>
{{/if}}