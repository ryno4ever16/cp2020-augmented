{{!--
  Explosion blast confirm card (CP2020 p.108). Rendered via renderTemplate with
  { weaponName, radius, baseDamage, fullWithin, templateId, outcomeLine }.

  ⏪ THE SCATTER BUTTON IS GONE (2026-08-28). A missed throw resolves its own landing at placement
  (damage-hooks.js _placeExplosion), so this card no longer asks whether the throw missed — it SAYS so,
  in `outcomeLine`, and carries ONE control. The confirm button's class and data-template-id are kept
  verbatim so the existing global click handler fires unchanged. i18n via CPLocal (matches
  templates/chat/suppressive.hbs); triple-stash on the summary because it carries <b>.
--}}
<div class="cyberpunk save-prompt">
  <h3>{{CPLocal "ExplosionConfirmTitle" weapon=weaponName}}</h3>
  <div class="save-info">
    {{#if wordSummary}}
    <span>{{{CPLocal "ExplosionConfirmWordSummary" radius=radius effect=wordSummary}}}</span><br>
    {{else}}
    <span>{{{CPLocal "ExplosionConfirmSummary" radius=radius damage=baseDamage within=fullWithin}}}</span><br>
    {{/if}}
    {{#if outcomeLine}}<span class="cp-explosion-outcome">{{outcomeLine}}</span><br>{{/if}}
    <span class="save-note">{{CPLocal "ExplosionConfirmHint"}}</span>
  </div>
  <div class="save-buttons">
    <button class="cp-confirm-explosion" data-template-id="{{templateId}}">{{CPLocal "ExplosionConfirmBtn"}}</button>
  </div>
</div>
